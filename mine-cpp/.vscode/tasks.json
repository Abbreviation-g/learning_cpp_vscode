{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "CMake: configure (mingw)",
			"type": "process",
			"command": "cmake",
			"args": [
				"--preset",
				"mingw"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "CMake: build (mingw build)",
			"type": "process",
			"command": "cmake",
			"args": [
				"--build",
				"--preset",
				"mingwbuild"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"dependsOn": [
				"CMake: configure (mingw)"
			],
			"problemMatcher": [
				"$gcc"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "CMake: clean (mingw build)",
			"type": "process",
			"command": "cmake",
			"args": [
				"--build",
				"--preset",
				"mingwbuild",
				"--target",
				"clean"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
	]
}