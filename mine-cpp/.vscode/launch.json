{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Debug mine-cpp",
			"type": "cppdbg",
			"request": "launch",
			"program": "${workspaceFolder}/build/mingw/mine-cpp.exe",
			"cwd": "${workspaceFolder}",
			"MIMode": "gdb",
			"miDebuggerPath": "gdb",
			"stopAtEntry": true,
			// "preLaunchTask": "CMake: build (mingw build)",
			"setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
		}
	]
}
