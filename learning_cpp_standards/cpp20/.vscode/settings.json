{
    "C_Cpp.intelliSenseEngine": "disabled",
    "terminal.integrated.profiles.windows": {
        "PowerShell 7": {
            "args": [
                "-NoExit",
                "-Command",
                "chcp 65001 | Out-Null;",
                "[Console]::OutputEncoding = [System.Text.Encoding]::UTF8;",
                "[Console]::InputEncoding = [System.Text.Encoding]::UTF8"
            ],
            "path": "C:\\sw\\PowerShell-7.4.17\\pwsh.exe"
        }
    },
    // clangd 通过工程根目录的 .clangd 配置,
    // 但 --query-driver 必须在这里作为 clangd 启动参数设置,
    // 这样 clangd 才能向真正的 MinGW 编译器查询 include 路径。
    "clangd.path": "C:\\sw\\clang+llvm-22.1.0-x86_64-pc-windows-msvc\\bin\\clangd.exe",
    "clangd.arguments": [
        "--compile-commands-dir=build/mingw",
        // "--query-driver=C:/msys64/ucrt64/bin/g++.exe",
        "--clang-tidy"
    ],
    "terminal.integrated.defaultProfile.windows": "PowerShell 7",
    "C_Cpp.formatting": "clangFormat",
    "clang-format.executable": "C:/sw/clang+llvm-22.1.0-x86_64-pc-windows-msvc/bin/clang-format.exe"
}
